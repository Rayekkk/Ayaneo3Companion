{
  "name": "ayaneo3companion",
  "version": "1.3.0",
  "description": "AYANEO 3 hardware controls for Decky Loader",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "rollup -c && node scripts/check-build.mjs",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.mjs",
    "test:backend": "python -m unittest discover -s tests -p \"test_*.py\" -v",
    "test:frontend": "node tests/frontend_lifecycle.cjs && node tests/frontend_navigation.cjs && node tests/frontend_tdp.cjs"
  },
  "devDependencies": {
    "@decky/api": "^1.1.3",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@decky/ui": "^4.12.0",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "rollup": "^4.64.3",
    "rollup-plugin-external-globals": "^0.13.0",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0"
  }
}
