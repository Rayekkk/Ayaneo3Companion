{
  "name": "ayaneo3companion",
  "version": "1.3.0",
  "description": "AYANEO 3 hardware controls for Decky Loader",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "rollup -c && node scripts/check-build.mjs",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test:backend": "python -W error -m unittest discover -s tests -p \"test_*.py\"",
    "test:frontend": "node --test \"tests/*.test.cjs\"",
    "package": "node scripts/package.mjs",
    "check": "npm run typecheck && npm run test:backend && npm run test:frontend && npm run build && npm run package"
  },
  "devDependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.12.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "rollup": "^4.64.3",
    "rollup-plugin-external-globals": "^0.13.0",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0"
  },
  "decky": {
    "files": [
      "*.py",
      "plugin.json",
      "package.json",
      "package-lock.json",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "NOTICE",
      "bootstrap.sh",
      "Install AYANEO 3 Companion.desktop",
      "rollup.config.js",
      "tsconfig.json",
      "src",
      "dist",
      "assets"
    ],
    "forbidden": [
      "(^|/)(tests|artifacts|build|bin)(/|$)"
    ],
    "folder": "Ayaneo3Companion",
    "python": [
      "3.14"
    ],
    "flags": [
      "root"
    ]
  }
}
